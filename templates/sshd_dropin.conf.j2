# {{ ansible_managed }}
# SSH hardening — managed by Ansible role harden

Port {{ harden.ssh.port }}

PermitRootLogin {{ harden.ssh.permit_root_login | ternary('yes', 'no') if harden.ssh.permit_root_login is boolean else harden.ssh.permit_root_login }}
PubkeyAuthentication {{ harden.ssh.pubkey_authentication | ternary('yes', 'no') }}
PasswordAuthentication {{ harden.ssh.password_authentication | ternary('yes', 'no') if harden.ssh.password_authentication is boolean else harden.ssh.password_authentication }}
ChallengeResponseAuthentication no
UsePAM yes
GSSAPIAuthentication no
GSSAPICleanupCredentials no

LogLevel INFO
SyslogFacility AUTH
PrintLastLog no

HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group14-sha256
HostKeyAlgorithms ssh-rsa,rsa-sha2-256,rsa-sha2-512,ssh-ed25519,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521

ClientAliveInterval {{ harden.ssh.client_alive_interval }}
ClientAliveCountMax {{ harden.ssh.client_alive_count_max }}
MaxAuthTries {{ harden.ssh.max_auth_tries }}
LoginGraceTime {{ harden.ssh.login_grace_time }}

X11Forwarding {{ harden.ssh.x11_forwarding | ternary('yes', 'no') }}
AllowAgentForwarding {{ harden.ssh.allow_agent_forwarding | ternary('yes', 'no') }}
AllowTcpForwarding {{ harden.ssh.allow_tcp_forwarding | ternary('yes', 'no') }}
GatewayPorts no
PermitTunnel no

UseDNS {{ harden.ssh.use_dns | ternary('yes', 'no') }}
TCPKeepAlive yes
Compression delayed
MaxStartups 10:30:60

AcceptEnv LANG LC_*
